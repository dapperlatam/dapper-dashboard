# Modo de datos: "demo" usa datos de prueba incluidos en el proyecto; "live" lee tus Google Sheets.
# Si no se define, se usa "live" cuando existe GOOGLE_SERVICE_ACCOUNT_JSON y "demo" en caso contrario.
DATA_MODE=demo

# IDs de los Google Sheets (la parte larga de la URL, entre /d/ y /edit)
SHEET_METAS_ID=1tmEzy12TqXEvAyewDLxPhyectPqq25CBdOuJXxDSiy4
SHEET_M3_ID=18pSQ17Lk9cZR6Wn4I3J4fg7JyDkA6-dvee1gvLtyHjU

# Contenido completo del JSON de la cuenta de servicio de Google (en una sola línea).
# NUNCA lo subas a GitHub. En Vercel se pega en Settings > Environment Variables.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Cada cuántos segundos se vuelven a leer los Sheets (por defecto 300)
REVALIDATE_SECONDS=300

# Primer lunes (fecha límite) que cuenta para los puntos de incumplimiento de updates (AAAA-MM-DD)
TRACKING_START=2026-10-19

# Contraseña opcional para todo el sitio (recomendado al publicar). Si no se definen, el sitio queda abierto.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
